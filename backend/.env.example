# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider selection (Phase 2-3, needed now) ---
# One of: anthropic | gemini | openai
LLM_PROVIDER=openai
# Optional override of the default model for the selected provider
LLM_MODEL=

# --- Provider API keys — you only need the ONE matching LLM_PROVIDER above ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Not needed yet — Phase 5 (database) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Not needed yet — Phase 6 (voice/SMS delivery) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
